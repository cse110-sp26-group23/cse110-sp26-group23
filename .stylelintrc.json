{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "unit-disallowed-list": [
      ["px"],
      {
        "ignoreProperties": {
          "px": [
            "--border-width",
            "--border-width-thick",
            "--shadow-card",
            "--shadow-panel"
          ]
        },
        "message": "Use a relative unit (rem/em/%) or a token from theme.css instead of px (see ADR-010)."
      }
    ]
  }
}
